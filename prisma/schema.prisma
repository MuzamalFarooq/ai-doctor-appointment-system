generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  JAZZCASH
  EASYPAISA
  CASH
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_COMPLETED
  PRESCRIPTION_ADDED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_STATUS_CHANGED
  PRESCRIPTION_STATUS
  SYSTEM
}

enum UrgencyLevel {
  EMERGENCY
  WITHIN_24_HOURS
  THIS_WEEK
  ROUTINE
}

enum MedicineOrderStatus {
  PENDING
  AWAITING_PRESCRIPTION
  PRESCRIPTION_REVIEW
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  REFUNDED
}

enum PrescriptionVerificationStatus {
  NOT_REQUIRED
  PENDING_UPLOAD
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(PATIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordChangedAt DateTime?
  doctor            Doctor?
  patient           Patient?
  notifications     Notification[]
  auditLogs         AuditLog[]
  chatsSent         ChatMessage[]        @relation("SentMessages")
  chatsReceived     ChatMessage[]        @relation("ReceivedMessages")
  resetTokens       PasswordResetToken[]
  medicineOrders    MedicineOrder[]

  @@map("users")
}

model Doctor {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  userId           String       @unique @db.ObjectId
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   String
  specializationId String?      @db.ObjectId
  degree           String[]
  experience       Int
  hospitalId       String?      @db.ObjectId
  hospital         Hospital?    @relation(fields: [hospitalId], references: [id])
  consultationFee  Float
  languages        String[]
  city             String
  location         String?
  education        Json[]
  awards           String[]
  biography        String?
  rating           Float        @default(0)
  totalReviews     Int          @default(0)
  profilePhoto     String?
  demoData         Boolean?     @default(false)
  status           DoctorStatus @default(PENDING)
  isVerified       Boolean      @default(false)
  totalEarnings    Float        @default(0)
  gender           String?
  licenseNumber    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  appointments      Appointment[]
  reviews           Review[]
  availability      Availability[]
  prescriptions     Prescription[]
  aiRecommendations AIRecommendation[]

  @@index([specialization])
  @@index([city])
  @@index([status])
  @@index([rating])
  @@map("doctors")
}

model Patient {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  address          String?
  bloodGroup       String?
  allergies        String[]
  chronicDiseases  String[]
  emergencyContact Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments    Appointment[]
  medicalHistory  MedicalHistory[]
  payments        Payment[]
  reviews         Review[]
  favoriteDoctors String[]         @db.ObjectId
  prescriptions   Prescription[]

  @@map("patients")
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String            @db.ObjectId
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String            @db.ObjectId
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  date            DateTime
  startTime       String
  endTime         String
  bookingKey      String?           @unique
  status          AppointmentStatus @default(PENDING)
  type            String            @default("in-person")
  reason          String?
  notes           String?
  symptoms        String[]
  consultationFee Float
  qrCode          String?
  videoRoomUrl    String?
  timezone        String            @default("Asia/Karachi")
  reminderSent    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payment      Payment?
  prescription Prescription?
  chatMessages ChatMessage[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

model Availability {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  doctorId     String     @db.ObjectId
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int        @default(30)
  isAvailable  Boolean    @default(true)
  blockedDates DateTime[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("availability")
}

model Prescription {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId    String      @unique @db.ObjectId
  appointment      Appointment @relation(fields: [appointmentId], references: [id])
  doctorId         String      @db.ObjectId
  doctor           Doctor      @relation(fields: [doctorId], references: [id])
  patientId        String      @db.ObjectId
  patient          Patient     @relation(fields: [patientId], references: [id])
  medicines        Json[]
  diagnosis        String?
  instructions     String?
  followUpDate     DateTime?
  digitalSignature String?
  pdfUrl           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("prescriptions")
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId   String        @unique @db.ObjectId
  appointment     Appointment   @relation(fields: [appointmentId], references: [id])
  patientId       String        @db.ObjectId
  patient         Patient       @relation(fields: [patientId], references: [id])
  amount          Float
  currency        String        @default("PKR")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?
  stripePaymentId String?
  invoiceUrl      String?
  couponCode      String?
  discount        Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([patientId])
  @@index([status])
  @@map("payments")
}

model Coupon {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  code         String    @unique
  discount     Float
  isPercentage Boolean   @default(true)
  maxUses      Int       @default(100)
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@map("coupons")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId String   @db.ObjectId
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String   @db.ObjectId
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  rating    Float
  comment   String?
  images    String[]
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@map("reviews")
}

model Hospital {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  address    String
  city       String
  phone      String?
  email      String?
  website    String?
  image      String?
  facilities String[]
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  doctors Doctor[]

  @@map("hospitals")
}

model Specialization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  demoData    Boolean? @default(false)
  createdAt   DateTime @default(now())

  @@map("specializations")
}

model MedicalHistory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  patientId   String    @db.ObjectId
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition   String
  diagnosedAt DateTime?
  treatment   String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@map("medicalHistory")
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AIRecommendation {
  id                        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId                    String?       @db.ObjectId
  doctorId                  String?       @db.ObjectId
  doctor                    Doctor?       @relation(fields: [doctorId], references: [id])
  symptoms                  String[]
  age                       Int?
  gender                    String?
  existingDiseases          String[]
  duration                  String?
  painLevel                 Int?
  allergies                 String[]
  aiResponse                String
  recommendedSpecialization String?
  urgencyLevel              UrgencyLevel?
  doctorIds                 String[]      @db.ObjectId
  createdAt                 DateTime      @default(now())

  @@map("aiRecommendations")
}

model ChatMessage {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  senderId      String       @db.ObjectId
  sender        User         @relation("SentMessages", fields: [senderId], references: [id])
  receiverId    String       @db.ObjectId
  receiver      User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  appointmentId String?      @db.ObjectId
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  content       String
  fileUrl       String?
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@map("chatMessages")
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@map("auditLogs")
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  authorId    String   @db.ObjectId
  tags        String[]
  category    String?
  isPublished Boolean  @default(false)
  views       Int      @default(0)
  readTime    Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogPosts")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RateLimit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

model MedicineCategory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique
  slug          String   @unique
  description   String?
  subcategories String[]
  icon          String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("medicine_categories")
}

model MedicineProduct {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  catalogKey           String              @unique
  name                 String
  genericName          String?
  brand                String?
  category             String
  subcategory          String?
  activeIngredients    String[]
  indications          String?
  description          String
  strength             String?
  dosageForm           String?
  packageSize          String?
  imageUrl             String?
  price                Float
  discountPrice        Float?
  stock                Int                 @default(0)
  sku                  String?
  prescriptionRequired Boolean             @default(false)
  storageInstructions  String?
  expiryDate           DateTime?
  status               String              @default("ACTIVE")
  manufacturer         String?
  sellerName           String?
  isActive             Boolean             @default(true)
  demoData             Boolean?            @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  batches              MedicineBatch[]
  orderItems           MedicineOrderItem[]

  @@index([category, isActive])
  @@index([subcategory])
  @@index([name])
  @@index([genericName])
  @@index([brand])
  @@map("medicine_products")
}

model MedicineBatch {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  medicineId      String          @db.ObjectId
  medicine        MedicineProduct @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  initialQuantity Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@map("medicine_batches")
}

model MedicineOrder {
  id                         String                         @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber                String                         @unique
  userId                     String?                        @db.ObjectId
  user                       User?                          @relation(fields: [userId], references: [id])
  customerName               String
  customerEmail              String
  customerPhone              String
  deliveryAddress            String
  city                       String
  postalCode                 String?
  orderNotes                 String?
  deliveryMethod             String                         @default("standard")
  paymentMethod              PaymentMethod                  @default(CASH)
  paymentStatus              PaymentStatus                  @default(PENDING)
  orderStatus                MedicineOrderStatus            @default(PENDING)
  prescriptionStatus         PrescriptionVerificationStatus @default(NOT_REQUIRED)
  prescriptionUrl            String?
  prescriptionNotes          String?
  prescriptionReviewedBy     String?                        @db.ObjectId
  prescriptionReviewedAt     DateTime?
  rejectionReason            String?
  cancellationReason         String?
  subtotal                   Float
  discountTotal              Float                          @default(0)
  deliveryFee                Float                          @default(0)
  finalTotal                 Float
  items                      MedicineOrderItem[]
  statusHistory              Json[]
  confirmedAt                DateTime?
  dispatchedAt               DateTime?
  deliveredAt                DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([prescriptionStatus])
  @@index([createdAt])
  @@map("medicine_orders")
}

model MedicineOrderItem {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String          @db.ObjectId
  order           MedicineOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId      String          @db.ObjectId
  medicine        MedicineProduct @relation(fields: [medicineId], references: [id])
  name            String
  genericName     String?
  sku             String?
  dosageForm      String?
  strength        String?
  unitPrice       Float
  discountPrice   Float?
  quantity        Int
  subtotal        Float
  prescriptionReq Boolean         @default(false)
  batchNumber     String?

  @@index([orderId])
  @@index([medicineId])
  @@map("medicine_order_items")
}

model LabTest {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  catalogKey              String   @unique
  name                    String
  category                String
  description             String
  price                   Float
  sampleType              String?
  preparationInstructions String?
  estimatedTurnaround     String?
  homeCollectionEligible  Boolean  @default(false)
  collectionLocations     String[]
  isActive                Boolean  @default(true)
  demoData                Boolean? @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([category, isActive])
  @@index([name])
  @@map("lab_tests")
}

model SurgicalSpecialty {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  name             String
  description      String
  consultationType String   @default("Clinical assessment")
  consultationFee  Float?
  isActive         Boolean  @default(true)
  demoData         Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@map("surgical_specialties")
}
