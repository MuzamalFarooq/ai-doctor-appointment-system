{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brandName": "MediConnect AI",
  "archetype": "Modern Clinical, Empathetic Healthcare & High-Tech Precision",
  "version": "2.0.0",
  "colorPalette": {
    "distribution": {
      "base60": "#F8FAFC",
      "structure30": "#FFFFFF",
      "accent10": "#0D9488"
    },
    "tokens": {
      "canvas": {
        "light": "#F8FAFC",
        "dark": "#0B132B"
      },
      "surface": {
        "light": "#FFFFFF",
        "dark": "#1C2541"
      },
      "brandPrimary": {
        "50": "#F0FDFA",
        "100": "#CCFBF1",
        "500": "#14B8A6",
        "600": "#0D9488",
        "700": "#0F766E",
        "glow": "rgba(13, 148, 136, 0.25)"
      },
      "brandSecondary": {
        "500": "#0EA5E9",
        "600": "#0284C7"
      },
      "accentVital": {
        "rose": "#F43F5E",
        "amber": "#F59E0B",
        "emerald": "#10B981"
      },
      "typography": {
        "heading": "#0F172A",
        "body": "#334155",
        "muted": "#64748B",
        "inverse": "#F8FAFC"
      }
    }
  },
  "typography": {
    "displayFont": "Plus Jakarta Sans, -apple-system, sans-serif",
    "bodyFont": "Inter, -apple-system, sans-serif",
    "monoFont": "Geist Mono, monospace",
    "scale": {
      "display": { "size": "40px", "lineHeight": "1.15", "letterSpacing": "-0.03em", "weight": 800 },
      "h1": { "size": "32px", "lineHeight": "1.2", "letterSpacing": "-0.025em", "weight": 700 },
      "h2": { "size": "24px", "lineHeight": "1.25", "letterSpacing": "-0.02em", "weight": 600 },
      "h3": { "size": "20px", "lineHeight": "1.3", "letterSpacing": "-0.015em", "weight": 600 },
      "body": { "size": "16px", "lineHeight": "1.6", "letterSpacing": "0", "weight": 400 },
      "caption": { "size": "13px", "lineHeight": "1.4", "letterSpacing": "+0.01em", "weight": 500 },
      "microBadge": { "size": "11px", "lineHeight": "1.3", "letterSpacing": "+0.04em", "weight": 700 }
    }
  },
  "elevation": {
    "softCard": "0 10px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04)",
    "floatingModal": "0 20px 40px -10px rgba(15, 23, 42, 0.14)",
    "brandGlow": "0 8px 24px -4px rgba(13, 148, 136, 0.35)"
  },
  "radii": {
    "sm": "6px",
    "md": "12px",
    "lg": "16px",
    "full": "9999px"
  }
}
